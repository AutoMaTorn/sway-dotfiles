set $super Mod4
set $alt Mod1

font pango:monospace 14
floating_modifier $super normal

# Debian's snippets: export WAYLAND_DISPLAY etc. to systemd/dbus (portals need it).
include /etc/sway/config.d/*
# The same for dbus on systems without systemd (Void); harmless on Debian.
exec dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway

### Outputs
# Wallpaper
output * bg ~/.config/wallpapers/wallpaper.jpeg fill
# Monitors (replaces autodisplay.sh / xrandr). Names: swaymsg -t get_outputs
# output eDP-1 scale 1.25
# Profiles for plug/unplug live in ~/.config/kanshi/config.

### Input (replaces setxkbmap + touchpad part of startup.sh)
input type:keyboard {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}

input type:touchpad {
    tap enabled
    dwt enabled
    natural_scroll enabled
    scroll_factor 0.5
}

# Touchpad gestures
bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev

### Autostart
# Without systemd nobody starts PipeWire (it brings up wireplumber + pipewire-pulse)
exec [ -d /run/systemd/system ] || pipewire
exec swaync
exec kanshi
# Polkit agent: lxpolkit on Debian, polkit-gnome on Void
exec command -v lxpolkit >/dev/null && exec lxpolkit || exec /usr/libexec/polkit-gnome-authentication-agent-1
exec nmcli general reload
exec nmcli radio wifi on
exec_always sponux --daemon

# Lock after 5 min, screen off after 10, lock before sleep
exec swayidle -w \
    timeout 300 '~/.config/sway/lock.sh' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '~/.config/sway/lock.sh'

### Apps
bindsym --to-code $super+Return exec kitty
bindsym --to-code $super+space exec fuzzel
bindsym --to-code $super+d exec sponux
bindsym --to-code $super+shift+s exec grim -g "$(slurp)" - | wl-copy -t image/png
bindsym --to-code Print exec mkdir -p ~/Pictures && grim ~/Pictures/$(date +%F_%H-%M-%S).png
bindsym --to-code $super+l exec ~/.config/sway/lock.sh
bindsym --to-code $super+e exec thunar
bindsym --to-code $super+w exec brave-browser
bindsym --to-code $super+t exec flatpak run org.telegram.desktop
bindsym --to-code $super+n exec swaync-client -t -sw
bindsym --to-code $super+Escape exec ~/.config/sway/power-menu.sh

### Media keys
bindsym --to-code XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --to-code XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --to-code XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --to-code XF86AudioPlay exec playerctl play-pause
bindsym --to-code XF86AudioNext exec playerctl next
bindsym --to-code XF86AudioPrev exec playerctl previous
bindsym --to-code XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --to-code XF86MonBrightnessUp exec brightnessctl set 5%+

### Windows
bindsym --to-code $super+q kill

bindsym --to-code $super+Left focus left
bindsym --to-code $super+Down focus down
bindsym --to-code $super+Up focus up
bindsym --to-code $super+Right focus right

bindsym --to-code $super+Shift+Left move left
bindsym --to-code $super+Shift+Down move down
bindsym --to-code $super+Shift+Up move up
bindsym --to-code $super+Shift+Right move right

bindsym --to-code $super+h split h
bindsym --to-code $super+v split v

bindsym --to-code $super+f fullscreen toggle
bindsym --to-code $alt+space floating toggle
bindsym --to-code $super+Shift+space focus mode_toggle

### Workspaces
bindsym --to-code $alt+Tab workspace next
bindsym --to-code $alt+Shift+Tab workspace prev
bindsym --to-code $super+Control+Right workspace next
bindsym --to-code $super+Control+Left workspace prev
bindsym --to-code $super+1 workspace number 1
bindsym --to-code $super+2 workspace number 2
bindsym --to-code $super+3 workspace number 3
bindsym --to-code $super+4 workspace number 4
bindsym --to-code $super+5 workspace number 5
bindsym --to-code $super+6 workspace number 6
bindsym --to-code $super+7 workspace number 7
bindsym --to-code $super+8 workspace number 8
bindsym --to-code $super+9 workspace number 9
bindsym --to-code $super+0 workspace number 10

bindsym --to-code $super+Shift+1 move container to workspace number 1
bindsym --to-code $super+Shift+2 move container to workspace number 2
bindsym --to-code $super+Shift+3 move container to workspace number 3
bindsym --to-code $super+Shift+4 move container to workspace number 4
bindsym --to-code $super+Shift+5 move container to workspace number 5
bindsym --to-code $super+Shift+6 move container to workspace number 6
bindsym --to-code $super+Shift+7 move container to workspace number 7
bindsym --to-code $super+Shift+8 move container to workspace number 8
bindsym --to-code $super+Shift+9 move container to workspace number 9
bindsym --to-code $super+Shift+0 move container to workspace number 10

### Session
bindsym --to-code $super+BackSpace reload
bindsym --to-code $super+shift+e exec swaynag -t warning -m 'Really, exit?' -B 'Yes' 'swaymsg exit'

bindsym --to-code $super+r mode "resize"
mode "resize" {
    bindsym --to-code Left resize shrink width 5 px or 5 ppt
    bindsym --to-code Down resize grow height 5 px or 5 ppt
    bindsym --to-code Up resize shrink height 5 px or 5 ppt
    bindsym --to-code Right resize grow width 5 px or 5 ppt
    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}

### Bar
bar {
    swaybar_command waybar
}

### Look
client.focused          #d9d9d9 #181818 #EDEDED #d9d9d9 #d9d9d9
client.focused_inactive #525252 #181818 #939393 #525252 #181818
client.unfocused        #525252 #181818 #939393 #525252 #181818
client.urgent           #ffffff #181818 #EDEDED #ffffff #ffffff
client.placeholder      #525252 #181818 #939393 #525252 #181818

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 8
gaps outer 0

# SwayFX only (built into ~/.local, see README); plain sway rejects these.
corner_radius 12
shadows disable
blur disable

# Settings windows opened from the bar float instead of tiling
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable

# Dark theme by default (GTK4/libadwaita via color-scheme, GTK3 via settings.ini)
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark
